<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Airlock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07090c</item>
        <item name="android:statusBarColor">#07090c</item>
        <item name="android:navigationBarColor">#07090c</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#5eead4</item>
    </style>

    <style name="Theme.Airlock.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
