<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN pairing speaks plain ws:// on the local network. Set
         cleartextTrafficPermitted="false" if you only ever use the cloud relay. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
